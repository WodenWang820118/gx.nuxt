# Environment Configuration
NODE_ENV=development # Options: development, production

# Development: SQLite3 (default)
# Production: Neon PostgreSQL

# Neon PostgreSQL Configuration (required for production)
DATABASE_URL=postgresql://username:password@your-neon-host.neon.tech/dbname?sslmode=require

# Optional: Override database type explicitly
# DB_TYPE=sqlite # Options: sqlite, postgres

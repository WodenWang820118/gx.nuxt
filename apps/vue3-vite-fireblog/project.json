{
  "name": "fireblog",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/vue3-vite-fireblog/src",
  "targets": {
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "fireblog:build",
        "port": 5173
      },
      "configurations": {
        "development": {
          "buildTarget": "fireblog:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "fireblog:build:production"
        }
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/vue3-vite-fireblog"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "fireblog:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "fireblog:build:development"
        },
        "production": {
          "buildTarget": "fireblog:build:production"
        }
      }
    }
  },
  "tags": []
}
